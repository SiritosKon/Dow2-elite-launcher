{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elite Launcher",
  "version": "1.2.8",
  "identifier": "mod.elite.launcher",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Elite Launcher", "width": 1120, "height": 700, "minWidth": 900, "minHeight": 600, "resizable": true, "center": true }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Install, update and launch Elite Mod for Dawn of War II: Retribution",
    "category": "Game"
  }
}
